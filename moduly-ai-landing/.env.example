# Copy this file to .env and fill in your real values
# NEVER commit your actual .env file!

# Supabase (used by Netlify functions)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LLM providers (used by Netlify functions)
OPENROUTER_API_KEY="your-openrouter-key"
NVIDIA_NIM_API_KEY="your-nvidia-key"
GROQ_API_KEY="your-groq-key"

# Object storage
UTHO_ENDPOINT="https://your-region.utho.io"
UTHO_REGION="your-region"
UTHO_BUCKET_NAME="your-bucket-name"
UTHO_ACCESS_KEY="your-utho-access-key"
UTHO_SECRET_KEY="your-utho-secret-key"
